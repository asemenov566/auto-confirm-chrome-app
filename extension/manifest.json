{
  "manifest_version": 3,
  "name": "Auto Confirm",
  "version": "1.0.0",
  "description": "Автоматическое подтверждение confirm на выбранных доменах.",
  "minimum_chrome_version": "111",
  "permissions": ["storage", "scripting"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {"service_worker": "worker.js", "type": "module"},
  "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"},
  "action": {"default_title": "Auto Confirm", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}},
  "options_ui": {"page": "settings.html", "open_in_tab": true}
}
